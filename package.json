{
  "name": "weiwei-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/dev.mjs --tauri",
    "build": "pnpm --filter @weiwei/contracts build && pnpm --filter @weiwei/desktop build",
    "build:desktop": "pnpm build && node scripts/package-dmg.mjs",
    "setup:api": "python3.11 -m venv services/market-api/.venv && services/market-api/.venv/bin/python -m pip install -e services/market-api"
  }
}
