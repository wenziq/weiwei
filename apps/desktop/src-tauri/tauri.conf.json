{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "危微",
  "version": "0.8.0",
  "identifier": "com.weiwei.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @weiwei/contracts build && pnpm --filter @weiwei/desktop dev",
    "beforeBuildCommand": "pnpm --filter @weiwei/contracts build && pnpm --filter @weiwei/desktop build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "危微 · 个人看盘",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["licenses/Lightweight-Charts-LICENSE.txt", "licenses/Lightweight-Charts-NOTICE.txt"],
    "macOS": { "signingIdentity": "-" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
